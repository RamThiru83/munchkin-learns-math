{
  "name": "munchkin-learns-math",
  "version": "1.4.0",
  "private": true,
  "description": "Gentle interactive maths games for little learners (ages ~4-7), inspired by Zvonkin's 'Math from Three to Seven'.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/gen-index.mjs && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "new-game": "node scripts/new-game.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:resume": "playwright test tests/resume.spec.js",
    "verify": "npm run check && npm run lint && npm run build && npm test",
    "test:playthrough": "playwright test tests/playthrough --project=desktop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
